# Copy this file to ".env" and fill in real values. .env is gitignored -
# never commit it. See README.md for exactly how to obtain each of these.

# --- YouTube ---
# Not actually used directly (the client_secrets.json file path is what
# matters - see YOUTUBE_CLIENT_SECRETS_PATH below), listed here as a
# reminder of what you'll need from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS_PATH=./client_secrets.json
YOUTUBE_PLAYLIST_ID=

# --- Rumble ---
RUMBLE_USERNAME=your_rumble_username_or_email
RUMBLE_PASSWORD=your_rumble_password

# --- Optional: social announcements after successful uploads ---
# Discord: channel settings -> Integrations -> Webhooks -> copy URL
DISCORD_WEBHOOK_URL=

# --- Twitter/X (pip install tweepy) ---
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Needs Read + Write permissions.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Reddit ACCOUNT #2 (pip install praw) ---
# Use a SEPARATE Reddit account from any locked/personal account.
# Create an app at https://www.reddit.com/prefs/apps (script type).
# _2 suffix = this account is independent of any other Reddit config.
REDDIT_CLIENT_ID_2=
REDDIT_CLIENT_SECRET_2=
REDDIT_USERNAME_2=your_reddit_username
REDDIT_PASSWORD_2=your_reddit_password
# Subreddit to post in (without r/ prefix, e.g. stackswopo)
REDDIT_SUBREDDIT=

# --- Instagram (Graph API) ---
# Required scopes: instagram_content_publish, pages_manage_posts
# Get a long-lived Page token from Meta Business Suite > Settings > Advanced.
# Your numeric Instagram Business Account ID (NOT your username).
# Leave blank — publisher stays disabled until these are filled in.
IG_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Facebook (Graph API) ---
# Required scopes: pages_manage_posts, pages_read_engagement
# Same long-lived Page token as Instagram if they share a Business account.
# Your numeric Facebook Page ID (visible in Page settings > About).
# Facebook GROUP posting is NOT supported - there is no approved API route.
# Leave blank — publisher stays disabled until these are filled in.
FB_PAGE_TOKEN=
FB_PAGE_ID=
