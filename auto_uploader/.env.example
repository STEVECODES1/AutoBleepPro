# Copy this file to ".env" and fill in real values. .env is gitignored -
# never commit it. See README.md for exactly how to obtain each of these.

# --- YouTube ---
# Not actually used directly (the client_secrets.json file path is what
# matters - see YOUTUBE_CLIENT_SECRETS_PATH below), listed here as a
# reminder of what you'll need from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS_PATH=./client_secrets.json
YOUTUBE_PLAYLIST_ID=

# --- Rumble ---
RUMBLE_USERNAME=your_rumble_username_or_email
RUMBLE_PASSWORD=your_rumble_password

# --- Optional: social announcements after successful uploads ---
# Discord: channel settings -> Integrations -> Webhooks -> copy URL
DISCORD_WEBHOOK_URL=

# --- Twitter/X (pip install tweepy) ---
# Create an app at https://developer.twitter.com/en/portal/dashboard
#
# THE ORDER MATTERS, and getting it wrong is the usual cause of a 401:
#   1. App -> User authentication settings -> set permission to Read and Write
#   2. THEN App -> Keys and tokens -> Regenerate Access Token and Secret
# Changing the permission does NOT update tokens that already exist, so
# tokens generated before step 1 stay read-only however many times you
# re-copy them.
#
# Two more things a 401 can mean:
#   - The app is not attached to a Project. X API v2 rejects standalone
#     apps; add it to a Project in the developer portal.
#   - The value is quoted or padded. .env values are literal, so
#     TWITTER_API_KEY="abc" sends the quotes as part of the key. No quotes.
#
# Run `python main.py --posting-status --verify` - it now tells you which
# of the four values is the problem instead of just "401".
#
# Shapes, as a sanity check: the ACCESS TOKEN is the only one containing a
# hyphen (it looks like 1234567890-AbCdEf...). If yours has no hyphen, the
# API key has been pasted into the wrong variable.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Reddit ACCOUNT #2 (pip install praw) ---
# Use a SEPARATE Reddit account from any locked/personal account.
# Create an app at https://www.reddit.com/prefs/apps (script type) WHILE
# LOGGED IN AS THAT ACCOUNT - Reddit expects one script app per account,
# and reusing another account's client_id looks like credential sharing.
# The _2 suffix is the account NAME, set by features.social_promoter.
# reddit_account in config.json. Change it there and here together to run
# a third account (REDDIT_CLIENT_ID_3, ...); nothing in code is hardcoded
# to _2, and the plain REDDIT_* variables are never read for it.
REDDIT_CLIENT_ID_2=
REDDIT_CLIENT_SECRET_2=
REDDIT_USERNAME_2=your_reddit_username
REDDIT_PASSWORD_2=your_reddit_password
# Subreddit to post in (without r/ prefix, e.g. stackswopo)
REDDIT_SUBREDDIT=

# --- Instagram (Graph API) ---
# Required scopes: instagram_content_publish, pages_manage_posts
# Get a long-lived Page token from Meta Business Suite > Settings > Advanced.
# Your numeric Instagram Business Account ID (NOT your username).
# Leave blank — publisher stays disabled until these are filled in.
IG_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Facebook (Graph API) ---
# Required scopes: pages_manage_posts, pages_read_engagement
# Same long-lived Page token as Instagram if they share a Business account.
# Your numeric Facebook Page ID (visible in Page settings > About).
# Facebook GROUP posting is NOT supported - there is no approved API route.
# Leave blank — publisher stays disabled until these are filled in.
FB_PAGE_TOKEN=
FB_PAGE_ID=

# --- Upload-Post (https://upload-post.com) ---
# One API key → publish to TikTok, Instagram, YouTube, Facebook, X, LinkedIn,
# Pinterest, Reddit, Threads, Discord, Telegram, Bluesky, Google Business and
# more in a single multipart POST.  Free plan: 10 uploads/month.
# No per-platform OAuth, no scraping, no Zernio.
# Setup:
#   1. Sign up at https://upload-post.com
#   2. Connect your social accounts on the dashboard
#   3. Copy your API key and profile username below
# The publisher is in publishers/upload_post.py and wired into the clip
# pipeline via post_clip_to_upload_post() in social_promoter.py.
# When enabled in config.json posting.platforms, it becomes the PRIMARY clip
# path — one call posts to every connected platform at once.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# --- Puter.com (https://puter.com) — free web-host bridge ---
# Used by the X/Twitter free-tier publisher (publishers/x_webhost.py) as a
# free public-hosting fallback.  When X_BASIC_BEARER_TOKEN is not set, the
# clip is uploaded to Puter and a copy-paste post text is printed.
# Get an API key at https://puter.com/developers (free).
PUTER_API_KEY=

# --- X/Twitter Basic tier ($200/mo) — optional paid route ---
# When set, the X publisher posts for real via X API v2 media/upload + /2/tweets.
# Without it, the free-tier path hosts the clip on Puter and prints
# copy-paste text.  The free tier is read-only as of 2025.
X_BASIC_BEARER_TOKEN=

# --- TikTok (free, via tiktok-api-client or tiktokautouploader) ---
# Route 1 — OAuth (needs a TikTok developer app, free at developers.tiktok.com):
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
# Route 2 — browser fallback (no dev app needed, uses tiktokautouploader):
TIKTOK_USERNAME=
TIKTOK_PASSWORD=
# Default caption title for TikTok clips (optional):
TIKTOK_DEFAULT_TITLE=
TIKTOK_HASHTAGS=#fyp #foryou

# --- Instagram (instagrapi, free unofficial route) ---
# Backs up the Graph API path.  Works with any account you can log into on
# the app — no Business Account, no Page token needed.
# Setup: pip install instagrapi, then log in once; session is persisted.
INSTA_USERNAME=
INSTA_PASSWORD=
INSTA_SESSION_FILE=.instagrapi_session.json
INSTA_REEL_TAGS=#stackswopo

# --- Clip picking: LLM providers (autoreel/llm_highlights.py) ---
# The pipeline asks a model which moments are worth cutting. It tries
# every key you have, in this order, and falls to the next when one
# gives nothing:
#
#   1. GEMINI      - can be shown the FRAMES, so it picks best. Free tier.
#   2. XKIRO       - also sees the frames, so the vision pass is no longer
#                    a single point of failure. Free. Model ids carry a
#                    vendor prefix and a ':free' suffix that is PART of the
#                    id - "qwen/qwen3.8-omni-flash:free"; dropping it is a
#                    404. The catalogue mixes free and paid models under
#                    the same family names, so free ones are sorted first
#                    automatically.
#   3. CEREBRAS    - text-only, and the fastest backstop by a wide
#                    margin (0.017s measured). Free tier.
#   4. OPENAI      - text-only, paid.
#   5. ANTHROPIC   - text-only, paid.
#
# Any one of them is enough; more than one turns a bad day into a
# slightly slower one. Check them with: python main.py --check-llm
GEMINI_API_KEY=
GOOGLE_API_KEY=

# https://cloud.cerebras.ai - models: GET https://api.cerebras.ai/v1/models
# NOTE: the current models (gpt-oss-120b) are REASONING models. They spend
# tokens thinking before writing any answer, so the request budget in
# _CEREBRAS_MAX_TOKENS is deliberately generous - a small one returns no
# content at all, which reads exactly like a model with no opinion.
CEREBRAS_API_KEY=

# https://api.xkiro.com - models: GET https://api.xkiro.com/v1/models
# OpenAI-compatible: base URL https://api.xkiro.com/v1
# The ':free' suffix on a model id is part of the id, not a flag.
XKIRO_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
