__pycache__/
*.pyc
*_CLEAN.mp4
autoreel_output/

# auto_uploader secrets/state - never commit these
auto_uploader/.env
auto_uploader/client_secrets.json
auto_uploader/youtube_token.json
auto_uploader/uploaded_hashes.json
auto_uploader/logs/*.log
auto_uploader/watch_folder/*
!auto_uploader/watch_folder/.gitkeep
auto_uploader/uploaded/*
!auto_uploader/uploaded/.gitkeep
auto_uploader/censored/*
!auto_uploader/censored/.gitkeep
# In-progress stream recordings - large, and half of one is worthless
auto_uploader/recording/*
!auto_uploader/recording/.gitkeep
auto_uploader/clips/*
!auto_uploader/clips/.gitkeep
