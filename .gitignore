__pycache__/
*.pyc
*_CLEAN.mp4
autoreel_output/

# auto_uploader secrets/state - never commit these
auto_uploader/.env
# Every .env variant, including the dated backups --setup-meta takes
# before it writes. Those hold the full set of credentials, and one
# `git add -A` would publish them to a public repo - the ignore has to
# cover the backups, not just the file itself.
.env
.env.*
*/.env
*/.env.*
auto_uploader/client_secrets.json
auto_uploader/youtube_token.json
auto_uploader/uploaded_hashes.json
auto_uploader/logs/*.log
# Same for a run started from the repo root - clips.log got committed
# once already, carrying 300 lines of test output into the repo.
logs/*.log
# Runtime output, not source: the manual-post queue and posting state
auto_uploader/logs/manual_posts.txt
auto_uploader/posting_state.json
auto_uploader/clip_jobs.json
auto_uploader/STOP_POSTING
auto_uploader/watch_folder/*
!auto_uploader/watch_folder/.gitkeep
auto_uploader/uploaded/*
!auto_uploader/uploaded/.gitkeep
auto_uploader/censored/*
!auto_uploader/censored/.gitkeep
# In-progress stream recordings - large, and half of one is worthless
auto_uploader/recording/*
!auto_uploader/recording/.gitkeep
auto_uploader/clips/*
!auto_uploader/clips/.gitkeep

# Browser cookie exports. These are session tokens - a leaked cookies.txt
# is account access without a password - and they are untracked today
# only because nobody has run `git add -A` yet.
cookies.txt
*cookies.txt
*_cookies.txt

# Editor/manual backups. Git is the version history; a .backup beside the
# real file just diverges from it silently.
*.backup
*.bak
/clip_memory.json

# What this channel has been heard saying, kept so the next transcript
# is biased toward the words it really uses - see autoreel/vocabulary.py.
# It normally lives under auto_uploader/censored/ and is already covered
# by that rule; named here as well because it is a list of slurs with
# counts beside them and it must never end up in a commit by accident.
vocabulary.json

# Your live settings. Tracked as config.example.json instead, so a
# pull can never collide with a switch you flipped locally.
/auto_uploader/config.json
# Same reasoning, same file under another name - a hand-made copy of the
# live settings is still the live settings.
auto_uploader/config.mine.json

# The YouTube Shorts OAuth token, and the reason this rule exists:
# .gitignore already guarded 'youtube_token.json' (line 17), but the
# uploader actually WRITES 'youtube_shorts_token.json'. The near-miss sat
# untracked for weeks and would have gone in on the first `git add -A`.
# It holds a client_secret and a refresh_token - i.e. lasting access to
# the channel.
auto_uploader/youtube_shorts_token.json
auto_uploader/*_token.json

# Playwright browser profiles. user_data_dir is a full logged-in session:
# cookies for every site the uploaders touch, which is account access
# without a password. Two of them exist because one script launches from
# the repo root and another from auto_uploader/.
browser_profile/
auto_uploader/browser_profile/

# Scratch verification runs - recorded media, extracted audio, frame
# grabs and HF model cache. Not source, and ~1 GB of it.
_verify/

# A separate project checked out inside this one. It has its own .git, so
# committing it would store a dangling gitlink instead of the files.
/OpenChatCut/

# Log artefacts that are not *.log, so the rules above miss them.
# rumble_page_dump_*.html are full page saves of the Rumble dashboard,
# which include the logged-in account's own listings.
auto_uploader/logs/*
!auto_uploader/logs/.gitkeep

# Downloaded stream media - large, and re-downloadable from the VOD.
auto_uploader/downloaded_clips/
auto_uploader/downloaded_vods/
